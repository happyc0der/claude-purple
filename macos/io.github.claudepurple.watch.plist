<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.claudepurple.watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>HOME_PLACEHOLDER/Library/Application Support/ClaudePurple/claude-purple-watch.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>HOME_PLACEHOLDER/Library/Application Support/ClaudePurple/watch.err</string>
</dict>
</plist>
